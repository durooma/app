# Copy to .env and adjust. Used by docker-compose and make run.
POSTGRES_PASSWORD=change-me
HTTP_PORT=8080
BASE_CURRENCY=CHF

# Add your OpenRouter API key, model and request limits in the app's Settings.
# Legacy AI_API_KEY / AI_PROVIDER / AI_MODEL / AI rate-limit variables are ignored.
# The server generates a private encryption key here on first startup (local runs).
# Back up this file separately from the database. Docker uses the app-secrets volume.
# CREDENTIALS_KEY_FILE=.durooma/credentials.key

AI_POLL_INTERVAL=30s

# For local (non-docker) runs, the app defaults to:
# DATABASE_URL=postgres://durooma:durooma@localhost:5432/durooma?sslmode=disable

# Optional: OpenRouter key used only by the comparison eval configuration.
# OPENROUTER_API_KEY=
