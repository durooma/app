# Copy to .env and adjust. Used by docker-compose and make run.
POSTGRES_PASSWORD=change-me
HTTP_PORT=8080
BASE_CURRENCY=CHF

# AI categorization. AI_PROVIDER: gemini | none
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=

# Request pacing (shared by automatic and manual categorization).
# Enable automatic categorization in the app under Settings; it defaults to off.
AI_BATCH_SIZE=30
AI_REQUESTS_PER_DAY=200
AI_REQUEST_INTERVAL=1m
AI_POLL_INTERVAL=30s

# For local (non-docker) runs, the app defaults to:
# DATABASE_URL=postgres://durooma:durooma@localhost:5432/durooma?sslmode=disable
